<Window x:Class="U_Wii_X_Fusion.Xbox360FtpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xbox 360 FTP（Aurora）"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PrimaryBg}">
    <Grid Background="{StaticResource SecondaryBg}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="3" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="14" Background="{StaticResource AccentColor}" CornerRadius="1" Margin="0,0,8,0"/>
                <TextBlock Text="Xbox 360 FTP 连接" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
        </Border>

        <!-- 连接设置 -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="IP：" VerticalAlignment="Center" Margin="0,4" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <TextBox x:Name="txtIp" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="0,2" Padding="4,2" Style="{StaticResource RetroTextBox}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="端口：" VerticalAlignment="Center" Margin="8,4" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <TextBox x:Name="txtPort" Grid.Row="0" Grid.Column="3" Text="21" VerticalAlignment="Center" Margin="0,2" Padding="4,2" Style="{StaticResource RetroTextBox}" FontSize="11"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="用户：" VerticalAlignment="Center" Margin="0,4" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <TextBox x:Name="txtUser" Grid.Row="1" Grid.Column="1" Text="xboxftp" VerticalAlignment="Center" Margin="0,2" Padding="4,2" Style="{StaticResource RetroTextBox}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="密码：" VerticalAlignment="Center" Margin="8,4" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <TextBox x:Name="txtPass" Grid.Row="1" Grid.Column="3" Text="xboxftp" VerticalAlignment="Center" Margin="0,2" Padding="4,2" Style="{StaticResource RetroTextBox}"/>
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnTest" Content="测试" Width="70" Padding="6,3" Margin="0,0,6,0" Click="BtnTest_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                    <Button x:Name="btnSave" Content="保存" Width="70" Padding="6,3" Margin="0,0,6,0" Click="BtnSave_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                    <Button x:Name="btnDownloadDb" Content="下载DB" Width="80" Padding="6,3" Margin="0,0,6,0" ToolTip="下载 settings.db 和 Content.db" Click="BtnDownloadDb_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                    <Button x:Name="btnListDirs" Content="列目录" Width="80" Padding="6,3" Margin="0,0,6,0" ToolTip="列出 /Game/Data/GameData/" Click="BtnListDirs_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                    <Button x:Name="btnOpenDbViewer" Content="DB查看" Width="80" Padding="6,3" ToolTip="预览与修改 Content.db、settings.db" Click="BtnOpenDbViewer_Click" Style="{StaticResource RetroAccentButton}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 目录列表 -->
        <GroupBox Grid.Row="2" Header="目录列表" Style="{StaticResource RetroGroupBox}" BorderBrush="{StaticResource BorderColor}" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtListHint" Grid.Row="0" Text="点击「列目录」获取主机上的资源目录。" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" FontSize="10"/>
                <ListBox x:Name="lstDirs" Grid.Row="1" MinHeight="100" Style="{StaticResource {x:Type ListBox}}"/>
            </Grid>
        </GroupBox>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="8,6" CornerRadius="3">
            <TextBlock x:Name="txtStatus" Text="就绪" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
