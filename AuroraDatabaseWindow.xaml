<Window x:Class="U_Wii_X_Fusion.AuroraDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora 数据库预览与修改"
        Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        MinHeight="400" MinWidth="700"
        Background="{StaticResource PrimaryBg}">
    <Grid Background="{StaticResource SecondaryBg}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="3" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="14" Background="{StaticResource AccentColor}" CornerRadius="1" Margin="0,0,8,0"/>
                <TextBlock Text="Aurora 数据库预览与修改" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
        </Border>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="数据库：" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                <ComboBox x:Name="cmbDbFile" Grid.Column="1" MinWidth="280" VerticalAlignment="Center" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}"
                          SelectionChanged="CmbDbFile_SelectionChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="btnOpen" Content="打开" Width="90" Padding="6,3" Margin="0,0,6,0" Click="BtnOpen_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                    <Button x:Name="btnRefresh" Content="刷新" Width="60" Padding="6,3" Margin="0,0,6,0" Click="BtnRefresh_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                    <Button x:Name="btnSave" Content="保存" Width="70" Padding="6,3" Click="BtnSave_Click" Style="{StaticResource RetroAccentButton}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="表 / Lua 脚本" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="11"/>
                    <ListBox x:Name="lstTables" Grid.Row="1" SelectionChanged="LstTables_SelectionChanged"
                             DisplayMemberPath="DisplayName" Style="{StaticResource {x:Type ListBox}}"/>
                    <TextBlock x:Name="txtLuaHint" Grid.Row="2" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="txtTableCaption" Grid.Row="0" Text="选择左侧表以预览数据" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,6"/>
                    <DataGrid x:Name="dgData" Grid.Row="1" Style="{StaticResource RetroDataGrid}" AutoGenerateColumns="True" IsReadOnly="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="True"
                              CanUserResizeColumns="True" CanUserSortColumns="True"
                              GridLinesVisibility="None" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionUnit="Cell"
                              RowEditEnding="DgData_RowEditEnding" CellEditEnding="DgData_CellEditEnding"
                              LoadingRow="DgData_LoadingRow"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="8,6" Margin="0,8,0,0" CornerRadius="3">
            <TextBlock x:Name="txtStatus" Text="" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
        </Border>
    </Grid>
</Window>
