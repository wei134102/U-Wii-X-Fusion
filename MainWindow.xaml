<Window x:Class="U_Wii_X_Fusion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:U_Wii_X_Fusion"
        mc:Ignorable="d"
        Title="U-Wii-X Fusion" Height="850" Width="1200"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PrimaryBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBg}" Padding="12,8" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <!-- 复古像素风装饰线 -->
                        <Border Width="4" Height="16" Background="{StaticResource AccentColor}" CornerRadius="1" Margin="0,0,8,0"/>
                        <TextBlock Text="U-Wii-X Fusion" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="txtHeaderVersion" Text=" v0.0.0.0" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Bottom" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="txtHeaderSubtitle" Text="多合一游戏管理工具 | by: B站 86年复古游戏厅" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnLanguage" Content="EN" Padding="10,4" Margin="0,0,6,0" Background="{StaticResource PanelBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Cursor="Hand" Click="BtnLanguage_Click" FontSize="11" Height="28" Style="{StaticResource RetroButtonBase}"/>
                    <Button x:Name="btnCheckUpdate" Content="检查更新" Padding="10,4" Background="{StaticResource PanelBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Cursor="Hand" Click="BtnCheckUpdate_Click" FontSize="11" Height="28" Style="{StaticResource RetroButtonBase}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <TabControl Grid.Row="1" Margin="0" TabStripPlacement="Left"
                    Style="{StaticResource RetroTabControl}">

            <!-- 设置标签页 -->
            <TabItem x:Name="tabSettings" Header="设置" Style="{StaticResource RetroTabItem}">
                <Grid Background="{StaticResource SecondaryBg}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="txtSettingsTitle" Text="设置" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                            <Expander x:Name="expGeneral" Style="{StaticResource RetroExpander}" Header="通用设置" IsExpanded="True" Margin="0,0,0,8">
                                <StackPanel Margin="10,8,0,0">
                                    <CheckBox x:Name="chkAutoUpdate" Content="启用自动更新" Style="{StaticResource RetroCheckBox}"/>
                                    <CheckBox x:Name="chkEnableLogging" Content="启用日志记录" Style="{StaticResource RetroCheckBox}"/>
                                    <CheckBox x:Name="chkCheckDevices" Content="启动时检查设备" Style="{StaticResource RetroCheckBox}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblTheme" Text="主题:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <ComboBox x:Name="cboTheme" Width="200" Margin="0,0,8,0" Style="{StaticResource RetroComboBox}" SelectionChanged="CboTheme_SelectionChanged">
                                            <ComboBoxItem Content="默认 (红色)" Tag="Default"/>
                                            <ComboBoxItem Content="蓝色" Tag="Blue"/>
                                            <ComboBoxItem Content="绿色" Tag="Green"/>
                                            <ComboBoxItem Content="紫色" Tag="Purple"/>
                                            <ComboBoxItem Content="橙色" Tag="Orange"/>
                                            <ComboBoxItem Content="青色" Tag="Cyan"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="expEmulator" Style="{StaticResource RetroExpander}" Header="模拟器路径设置" IsExpanded="False" Margin="0,0,0,8">
                                <StackPanel Margin="10,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblDolphinPath" Text="Dolphin 模拟器:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtDolphinPath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}" IsReadOnly="True"/>
                                        <Button x:Name="btnBrowseDolphin" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblSwitchPath" Text="Switch 模拟器:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtSwitchPath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}" IsReadOnly="True"/>
                                        <Button x:Name="btnBrowseSwitch" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblPlayStationPath" Text="PS 模拟器:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtPlayStationPath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}" IsReadOnly="True"/>
                                        <Button x:Name="btnBrowsePlayStation" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="expPath" Style="{StaticResource RetroExpander}" Header="路径设置" IsExpanded="True" Margin="0,0,0,8">
                                <StackPanel Margin="10,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblGamePath" Text="游戏存储路径:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtGamePath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}"/>
                                        <Button x:Name="btnBrowseGamePath" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblDatabasePath" Text="数据库路径:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtDatabasePath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}"/>
                                        <Button x:Name="btnBrowseDatabasePath" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblCoverPath" Text="封面存储路径:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtCoverPath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}"/>
                                        <Button x:Name="btnBrowseCoverPath" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblWiiUCoverPath" Text="Wii U 封面路径:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtWiiUCoverPath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}"/>
                                        <Button x:Name="btnBrowseWiiUCoverPath" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblXboxCoverPath" Text="Xbox 360 封面路径:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtXboxCoverPath" Width="320" Margin="0,0,8,0" Style="{StaticResource RetroTextBox}"/>
                                        <Button x:Name="btnBrowseXboxCoverPath" Content="浏览..." Width="60" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="expNetwork" Style="{StaticResource RetroExpander}" Header="网络设置" Margin="0,0,0,8">
                                <StackPanel Margin="10,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock x:Name="lblApiKey" Text="元数据API密钥:" Width="100" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                        <TextBox x:Name="txtApiKey" Width="320" Style="{StaticResource RetroTextBox}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="chkEnableProxy" Content="启用代理" Margin="0,6,0,0" Style="{StaticResource RetroCheckBox}"/>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="expCoverDownload" Style="{StaticResource RetroExpander}" Header="封面下载设置" IsExpanded="True" Margin="0,0,0,8">
                                <StackPanel Margin="10,8,0,0">
                                    <TextBlock Text="Wii / Wii U 从 GameTDB 下载哪些类型的封面：" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="chkCover2D" Content="2D 封面" Style="{StaticResource RetroCheckBox}" Margin="0,0,16,0"/>
                                        <CheckBox x:Name="chkCover3D" Content="3D 封面" Style="{StaticResource RetroCheckBox}" Margin="0,0,16,0"/>
                                        <CheckBox x:Name="chkCoverDisc" Content="Disc 封面" Style="{StaticResource RetroCheckBox}" Margin="0,0,16,0"/>
                                        <CheckBox x:Name="chkCoverFull" Content="Full 封面" Style="{StaticResource RetroCheckBox}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Button x:Name="btnSaveSettings" Content="保存设置" Width="100" Height="30" Margin="0,16,0,0"
                                    Style="{StaticResource RetroAccentButton}" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Wii标签页 -->
            <TabItem x:Name="tabWii" Header="WII" Style="{StaticResource RetroTabItem}">
                <Grid Background="{StaticResource SecondaryBg}">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：列表和操作 -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Name="txtWiiSectionTitle" Text="Wii / NGC 游戏管理" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Grid Width="200" Margin="12,0,0,0">
                                    <ComboBox x:Name="cboDiskDrive" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Foreground="{StaticResource TextPrimary}" FontSize="11" Padding="4,2" DisplayMemberPath="DisplayName" SelectionChanged="CboDiskDrive_SelectionChanged">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="{StaticResource CardBg}"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                <Setter Property="Padding" Value="8,4"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource HoverBg}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SelectedBg}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SelectedForeground}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <TextBlock x:Name="txtDiskDrivePlaceholder" Text="选择磁盘..." Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="txtGameCount" Text="游戏数: 0" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 筛选栏 - 可折叠 -->
                            <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,6">
                                <StackPanel>
                                    <Grid Background="{StaticResource ExpanderHeaderBg}" Height="32">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="筛选" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment=" center" Margin="10,0,0,0"/>
                                        <Button Grid.Column="1" x:Name="btnWiiFilterToggle" Background="Transparent" BorderThickness="0" Width="32" Height="32" Click="BtnWiiFilterToggle_Click" Cursor="Hand">
                                            <Path x:Name="arrowWiiFilter" Data="M 0 4 L 4 8 L 8 4 Z" Fill="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="pnlWiiFilterContent" Margin="10" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="类别:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbWiiGenreFilter" Width="120" Height="26" Margin="0,0,8,0" SelectionChanged="CmbWiiFilter_SelectionChanged" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                                <ComboBoxItem Content="全部类别" IsSelected="True"/>
                                            </ComboBox>
                                            <TextBlock Text="控制器:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbWiiControllerFilter" Width="140" Height="26" Margin="0,0,8,0" SelectionChanged="CmbWiiFilter_SelectionChanged" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                                <ComboBoxItem Content="全部控制器" IsSelected="True"/>
                                            </ComboBox>
                                            <TextBlock Text="人数:" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="cmbWiiPlayersFilter" Width="80" Height="26" Margin="0,0,8,0" SelectionChanged="CmbWiiFilter_SelectionChanged" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                                <ComboBoxItem Content="全部人数" IsSelected="True"/>
                                            </ComboBox>
                                            <Button x:Name="btnWiiFilterReset" Content="重置" Width="56" Height="26" Padding="4,1" Click="BtnWiiFilterReset_Click" Style="{StaticResource RetroButtonBase}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 操作按钮行 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="btnAddSource" Content="添加" Width="60" Padding="4,2" Margin="0,0,4,0" Click="BtnAddSource_Click" Style="{StaticResource RetroButtonBase}" FontSize="10">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="添加游戏文件夹" Click="MenuAddDirectory_Click" Icon="📁"/>
                                            <MenuItem Header="添加游戏文件" Click="MenuAddFile_Click" Icon="📄"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="btnSelectMissingOnDisk" Content="选择" Width="60" Padding="4,2" Margin="0,0,4,0" Click="BtnSelectMissingOnDisk_Click" Style="{StaticResource RetroButtonBase}" FontSize="10">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="全选" Click="BtnWiiSelectAll_Click"/>
                                            <MenuItem Header="反选" Click="BtnWiiInvertSelect_Click"/>
                                            <MenuItem Header="清空选择" Click="BtnWiiClearSelect_Click"/>
                                            <Separator/>
                                            <MenuItem Header="选择磁盘1缺失" Click="MenuSelectMissingOnDisk1_Click"/>
                                            <MenuItem Header="选择磁盘2缺失" Click="MenuSelectMissingOnDisk2_Click"/>
                                            <Separator/>
                                            <MenuItem Header="导入游戏列表" Click="BtnWiiLoadList_Click"/>
                                            <MenuItem Header="导出游戏列表" Click="BtnWiiSaveList_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="btnRemoveSelected" Content="删除" Width="60" Padding="4,2" Margin="0,0,4,0" Click="BtnRemoveSelected_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Button x:Name="btnCopyToDisk" Content="拷贝" Width="60" Padding="4,2" Margin="0,0,4,0" Click="BtnCopyMenu_Click" Style="{StaticResource RetroButtonBase}" FontSize="10">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="拷贝到磁盘1" Click="MenuCopyToDisk1_Click"/>
                                            <MenuItem Header="拷贝到磁盘2" Click="MenuCopyToDisk2_Click"/>
                                            <Separator/>
                                            <MenuItem Header="转换为WBFS" Click="MenuConvertToWbfs_Click"/>
                                            <MenuItem Header="转换为ISO" Click="MenuConvertToIso_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="btnWiiDownloadCovers" Content="封面" Width="60" Padding="4,2" Margin="0,0,4,0" Click="BtnWiiDownloadCovers_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Button x:Name="btnRenameGames" Content="重命名" Padding="4,2" Margin="0,0,4,0" Click="BtnRenameGames_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Button x:Name="btnGameQuery" Content="数据库查询" Padding="4,2" Margin="0,0,4,0" Click="BtnGameQuery_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Button x:Name="btnWiiPluginEditor" Content="插件编辑器" Width="90" Padding="4,2" Margin="0,0,4,0" Click="BtnWiiPluginEditor_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Separator Width="1" Margin="4,4"/>
                                <Button x:Name="btnListSourceDirectory" Content="目录" Width="56" Padding="4,2" Margin="0,0,4,0" Click="BtnListSourceDirectory_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Button x:Name="btnListSourceDisk1" Content="磁盘1" Width="56" Padding="4,2" Margin="0,0,4,0" Click="BtnListSourceDisk1_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Button x:Name="btnListSourceDisk2" Content="磁盘2" Width="56" Padding="4,2" Margin="0,0,4,0" Click="BtnListSourceDisk2_Click" Style="{StaticResource RetroButtonBase}" FontSize="10"/>
                                <Button x:Name="btnWiiList" Content="列表" Width="56" Padding="4,2" Margin="0,0,4,0" Click="BtnWiiList_Click" Style="{StaticResource RetroButtonBase}" FontSize="10">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="清空列表" Click="MenuWiiListClear_Click"/>
                                            <MenuItem Header="刷新列表" Click="MenuWiiListRefresh_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>

                            <!-- 游戏列表 -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" x:Name="dgGames" Style="{StaticResource RetroDataGrid}" AutoGenerateColumns="False"
                                          SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                                          GridLinesVisibility="None" HeadersVisibility="Column"
                                          PreviewMouseRightButtonDown="DgGames_PreviewMouseRightButtonDown"
                                          SelectionChanged="DgGames_SelectionChanged">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="使用 Dolphin 模拟器游玩" Click="MenuItemPlayWithDolphin_Click" Icon="🎮"/>
                                            <Separator/>
                                            <MenuItem Header="打开游戏目录" Click="MenuItemOpenGameFolder_Click" Icon="📁"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="选" Width="32" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DataGridTextColumn Header="ID" Width="80" Binding="{Binding GameId}"/>
                                        <DataGridTextColumn Header="游戏名称" Width="*" MinWidth="100" Binding="{Binding Title}"/>
                                        <DataGridTextColumn Header="中文名" Width="*" MinWidth="100" Binding="{Binding ChineseTitle}"/>
                                        <DataGridTextColumn Header="大小" Width="70" IsReadOnly="True" Binding="{Binding FormattedSize, Mode=OneWay}" SortMemberPath="Size"/>
                                        <DataGridTextColumn Header="平台" Width="50" Binding="{Binding Platform}"/>
                                        <DataGridTextColumn Header="格式" Width="45" Binding="{Binding Format}"/>
                                        <DataGridTextColumn Header="路径" Width="150" Binding="{Binding Path}" Visibility="Collapsed"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 状态栏 -->
                                <TextBlock x:Name="txtWiiListStatus" Grid.Row="1" Text="就绪" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                
                                <!-- 游戏详情 -->
                                <Grid Grid.Row="2" Margin="0,6,0,0" Height="90">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="3" Margin="0,0,4,0" Padding="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="简介" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" FontSize="10" Foreground="{StaticResource TextPrimary}">
                                                <TextBlock x:Name="txtSynopsis" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="3" Margin="4,0,0,0" Padding="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="信息" Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" FontSize="10" Foreground="{StaticResource TextPrimary}">
                                                <TextBlock x:Name="txtGameInfo" TextWrapping="Wrap"/>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- 右侧：封面预览 -->
                        <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <GroupBox x:Name="gbDiscCoverWii" Header="Disc 封面" Style="{StaticResource RetroGroupBox}" FontSize="10" Margin="0,0,0,4">
                                    <Border Background="{StaticResource SecondaryBg}" Padding="4" CornerRadius="3">
                                        <Image x:Name="imgDiscCover" Stretch="Uniform" />
                                    </Border>
                                </GroupBox>

                                <GroupBox x:Name="gb3DCoverWii" Header="3D 封面" Grid.Row="1" Style="{StaticResource RetroGroupBox}" FontSize="10" Margin="0,4,0,0">
                                    <Border Background="{StaticResource SecondaryBg}" Padding="4" CornerRadius="3">
