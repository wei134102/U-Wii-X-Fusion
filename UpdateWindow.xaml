<Window x:Class="U_Wii_X_Fusion.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新" Height="420" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PrimaryBg}">
    <Grid Background="{StaticResource SecondaryBg}" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="3" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Border Width="3" Height="14" Background="{StaticResource AccentColor}" CornerRadius="1" Margin="0,0,8,0"/>
                <TextBlock Text="检查更新" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="spUpdateInfo">
                    <TextBlock x:Name="txtStatus" Text="正在检查更新..." FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="txtCurrentVersion" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtLatestVersion" Text="" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtReleaseNotes" Text="" TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" Visibility="Collapsed" FontSize="11"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <ProgressBar x:Name="pbDownload" Grid.Row="2" Margin="0,0,0,10" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnDownload" Content="下载更新" Width="90" Padding="6,3" Margin="0,0,10,0" Click="BtnDownload_Click" IsEnabled="False" Style="{StaticResource RetroAccentButton}"/>
            <Button x:Name="btnCancel" Content="关闭" Width="70" Padding="6,3" Click="BtnCancel_Click" Style="{StaticResource RetroButtonBase}"/>
        </StackPanel>
    </Grid>
</Window>
