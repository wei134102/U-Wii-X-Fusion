<Window x:Class="U_Wii_X_Fusion.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="图片预览"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <Border Background="#CC000000" 
            BorderBrush="#40FFFFFF" 
            BorderThickness="1" 
            CornerRadius="8"
            MouseRightButtonDown="Border_MouseRightButtonDown">
        <Grid>
            <Image x:Name="imgPreview" 
                   Stretch="Uniform"
                   RenderTransformOrigin="0.5,0.5"
                   MouseWheel="ImgPreview_MouseWheel"
                   MouseLeftButtonDown="ImgPreview_MouseLeftButtonDown"
                   MouseLeftButtonUp="ImgPreview_MouseLeftButtonUp"
                   MouseMove="ImgPreview_MouseMove">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                        <TranslateTransform x:Name="translateTransform" X="0" Y="0"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <TextBlock Text="右键关闭 | 滑轮缩放 | 拖动移动" 
                       Foreground="#80FFFFFF" 
                       FontSize="12" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,10"/>
        </Grid>
    </Border>
</Window>