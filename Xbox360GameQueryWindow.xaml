<Window x:Class="U_Wii_X_Fusion.Xbox360GameQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Xbox 360 游戏数据库"
        Height="700" Width="880"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBg}">
    <Grid Background="{StaticResource SecondaryBg}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="3" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="3" Height="14" Background="{StaticResource AccentColor}" CornerRadius="1" Margin="0,0,8,0"/>
                    <TextBlock Text="Xbox 360 游戏数据库查询" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✕" Width="28" Height="22" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" FontSize="12"
                            Click="BtnCloseQuery_Click" Cursor="Hand" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索区域 - 可折叠 -->
        <Expander Grid.Row="1" x:Name="expQueryFilter" Header="搜索" IsExpanded="True" Style="{StaticResource RetroExpander}" Margin="0,0,0,10">
            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="0,0,4,4" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtSearch" Width="240" Style="{StaticResource RetroTextBox}" ToolTip="输入游戏ID或名称"/>
                        <TextBlock Text="分类：" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="10" Margin="10,0,4,0"/>
                        <ComboBox x:Name="cmbCategory" Width="120" MinWidth="100" Style="{StaticResource RetroComboBox}" FontSize="10" SelectionChanged="CmbCategory_SelectionChanged" ItemContainerStyle="{StaticResource RetroComboBoxItem}"/>
                        <Button x:Name="btnSearch" Content="搜索" Width="60" Margin="10,0,0,0" Click="BtnSearch_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                        <Button x:Name="btnClearSearch" Content="清除" Width="60" Margin="6,0,0,0" Click="BtnClearSearch_Click" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                        <Button x:Name="btnDownloadCover" Content="下载封面" Width="76" Margin="6,0,0,0" Click="BtnDownloadCover_Click" Style="{StaticResource RetroAccentButton}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- 游戏列表和详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="游戏列表" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtGameCount" Text="" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid x:Name="dgGames" Grid.Row="1" Style="{StaticResource RetroDataGrid}" AutoGenerateColumns="False"
                          GridLinesVisibility="None" HeadersVisibility="Column"
                          SelectionChanged="DgGames_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="80" Binding="{Binding GameId}"/>
                        <DataGridTextColumn Header="游戏名称" Width="*" Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="中文名" Width="100" Binding="{Binding ChineseTitle}"/>
                        <DataGridTextColumn Header="分类" Width="70" IsReadOnly="True" Binding="{Binding Category, Mode=OneWay}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="1" Margin="12,0,0,0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8">
                <StackPanel>
                    <TextBlock Text="游戏详情" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="3" Background="{StaticResource SecondaryBg}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="封面" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Padding="6,4" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource AccentBg}" Height="160" CornerRadius="2" Margin="4">
                                <Image x:Name="imgCover" Stretch="Uniform" MouseLeftButtonDown="ImgCover_MouseLeftButtonDown"/>
                            </Border>
                            <TextBlock x:Name="txtCoverStatus" Text="请选择游戏查看封面" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="6,4,6,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="spGameDetails" MinHeight="80"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
