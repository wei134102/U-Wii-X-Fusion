<Window x:Class="U_Wii_X_Fusion.WiiUGameQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:U_Wii_X_Fusion"
        mc:Ignorable="d"
        Title="Wii U 游戏查询"
        Height="750" Width="950"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBg}">
    <Grid Background="{StaticResource SecondaryBg}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="{StaticResource AccentBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,6" CornerRadius="3" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="3" Height="14" Background="{StaticResource AccentColor}" CornerRadius="1" Margin="0,0,8,0"/>
                    <TextBlock Text="Wii U 游戏数据库查询" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="✕" Width="28" Height="22" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" FontSize="12"
                            Click="BtnCloseQuery_Click" Cursor="Hand" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索与筛选区域 - 可折叠 -->
        <Expander Grid.Row="1" x:Name="expQueryFilter" Header="搜索与筛选" IsExpanded="True" Style="{StaticResource RetroExpander}" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="False" MaxHeight="200">
            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="0,0,4,4" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="txtSearch" Width="260" Style="{StaticResource RetroTextBox}" ToolTip="输入游戏ID或名称"/>
                        <Button x:Name="btnSearch" Content="搜索" Width="64" Margin="8,0,0,0" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                        <Button x:Name="btnClearSearch" Content="清除" Width="64" Margin="6,0,0,0" Style="{StaticResource RetroButtonBase}" FontSize="11"/>
                    </StackPanel>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="类型: " Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbGenre" Width="130" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                <ComboBoxItem>全部游戏类型</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="平台: " Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbPlatform" Width="90" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                <ComboBoxItem>全部平台</ComboBoxItem>
                                <ComboBoxItem>Wii U</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="人数: " Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbPlayers" Width="75" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                <ComboBoxItem>全部人数</ComboBoxItem>
                                <ComboBoxItem>1人</ComboBoxItem>
                                <ComboBoxItem>2人</ComboBoxItem>
                                <ComboBoxItem>3人</ComboBoxItem>
                                <ComboBoxItem>4人</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="控制器: " Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbController" Width="110" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                <ComboBoxItem>全部控制器</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="区域: " Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbRegion" Width="85" Style="{StaticResource RetroComboBox}" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                <ComboBoxItem>全部区域</ComboBoxItem>
                                <ComboBoxItem>PAL</ComboBoxItem>
                                <ComboBoxItem>NTSC</ComboBoxItem>
                                <ComboBoxItem>NTSC-U</ComboBoxItem>
                                <ComboBoxItem>NTSC-J</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="btnApplyFilters" Content="应用筛选" Width="80" Style="{StaticResource RetroAccentButton}" FontSize="11"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Expander>

        <!-- 游戏列表和详情 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- 游戏列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="游戏列表" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtGameCount" Text="" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <DataGrid x:Name="dgGames" Grid.Row="1" Style="{StaticResource RetroDataGrid}" AutoGenerateColumns="False"
                          GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="80" Binding="{Binding GameId}"/>
                        <DataGridTextColumn Header="游戏名称" Width="*" Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="中文名" Width="120" Binding="{Binding ChineseTitle}"/>
                        <DataGridTextColumn Header="平台" Width="65" Binding="{Binding Platform}"/>
                        <DataGridTextColumn Header="区域" Width="65" Binding="{Binding Region}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 封面预览和游戏详情 -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="封面预览" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="类型: " Foreground="{StaticResource TextSecondary}" FontSize="10" VerticalAlignment="Center"/>
                                <ComboBox x:Name="cmbCoverType" Width="120" Style="{StaticResource RetroComboBox}" FontSize="10" ItemContainerStyle="{StaticResource RetroComboBoxItem}">
                                    <ComboBoxItem>2D</ComboBoxItem>
                                    <ComboBoxItem>3D</ComboBoxItem>
                                    <ComboBoxItem>disc</ComboBoxItem>
                                    <ComboBoxItem>full</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="3" Height="180" Background="{StaticResource SecondaryBg}" Cursor="Hand">
                                <Image x:Name="imgCover" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtCoverStatus" Text="请选择游戏查看封面" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="游戏详情" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                                <StackPanel x:Name="spGameDetails" MinHeight="100">
                                    <TextBlock Text="选择游戏查看详情" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,40,0,0" FontSize="11"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
